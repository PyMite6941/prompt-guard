# Example environment variables for Prompt Guard
# Copy to .env and fill in your values

# OpenAI API key (or compatible service)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI organization ID
OPENAI_ORG_ID=your_openai_org_id_here

# Optional: Base URL for OpenAI-compatible API (e.g., for local models or proxies)
# Example: http://localhost:11434/v1 for Ollama
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Encryption key for end-to-end protection (if implemented)
# PROMPT_GUARD_ENCRYPTION_KEY=your_encryption_key_here