{
	"name": "@ai-clyde/promptguard",
	"version": "1.1.0",
	"description": "Scan prompts for PII, secrets and prompt injection, and give AI agents policy-checked browser and account access without exposing credentials.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/",
		"examples/clean.txt",
		"examples/leak.txt",
		"examples/access-policy.json",
		"LICENSE",
		"README.md"
	],
	"bin": {
		"prompt-guard": "dist/cli.js"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc",
		"test": "vitest run",
		"dev": "vitest",
		"pre-commit": "node scripts/pre-commit.js",
		"prepublishOnly": "npm test && npm run build"
	},
	"keywords": [
		"prompt-security",
		"pii",
		"prompt-injection",
		"scanner",
		"secrets",
		"vault",
		"agent",
		"browser-automation",
		"credentials",
		"mcp"
	],
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PyMite6941/prompt-guard.git"
	},
	"homepage": "https://github.com/PyMite6941/prompt-guard#readme",
	"bugs": {
		"url": "https://github.com/PyMite6941/prompt-guard/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "commonjs",
	"devDependencies": {
		"@types/blessed": "^0.1.27",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"blessed": "^0.1.81",
		"dotenv": "^16.4.5",
		"openai": "^7.33.0"
	}
}
